{
  "package_version": 2,
  "version": "2.0.0",
  "name": "hermes-game-maker",
  "title": "Hermes Game Maker",
  "description": "i18n:hermes-game-maker.description",
  "editor": ">=3.8.0",
  "main": "./dist/main.js",
  "dependencies": {
    "fs-extra": "^10.0.0",
    "vue": "^3.1.4"
  },
  "devDependencies": {
    "@types/fs-extra": "^9.0.5",
    "@types/node": "^16.0.1",
    "typescript": "^4.9.5"
  },
  "panels": {
    "default": {
      "title": "Hermes Game Maker",
      "type": "dockable",
      "main": "dist/panels/default",
      "size": {
        "min-width": 400,
        "min-height": 300,
        "width": 1024,
        "height": 600
      }
    }
  },
  "contributions": {
    "menu": [
      {
        "path": "Develop",
        "label": "Hermes Game Maker",
        "message": "open-panel"
      }
    ],
    "messages": {
      "open-panel": {
        "methods": [
          "openPanel"
        ]
      },
      "execute-scene": {
        "methods": [
          "executeScene"
        ]
      }
    },
    "scene": {
      "script": "./dist/scene.js"
    }
  }
}